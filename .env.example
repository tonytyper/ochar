# copy this file to .env.local for your own machine, and put the same values
# in vercel under project settings -> environment variables.
# everything is optional: with nothing set, the site runs on the stand-in
# catalogue and orders come in by email.

# supabase: project settings -> api keys
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# server only. needed for saving orders and contact form messages
SUPABASE_SECRET_KEY=

# stripe: developers -> api keys. sk_test_... while testing, sk_live_... to sell
STRIPE_SECRET_KEY=
# developers -> webhooks, after adding the endpoint /api/stripe/webhook
STRIPE_WEBHOOK_SECRET=

# the live address once there's a domain, e.g. https://ocharsoap.com
NEXT_PUBLIC_SITE_URL=
